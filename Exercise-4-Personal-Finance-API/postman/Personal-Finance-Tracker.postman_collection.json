{
  "info": {
    "name": "Personal Finance Tracker API",
    "description": "End-to-end examples for the Personal Finance Tracker capstone.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "transactionId", "value": "67b2c3d4e5f6789012345678" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Aisha Khan",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Aisha Khan\",\n  \"email\": \"aisha.khan@example.com\",\n  \"password\": \"Aisha123!\"\n}" }, "url": "{{baseUrl}}/auth/register" },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('token', pm.response.json().token);"] } }]
        },
        {
          "name": "Login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"aisha.khan@example.com\",\n  \"password\": \"Aisha123!\"\n}" }, "url": "{{baseUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }]
        },
        { "name": "Profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/auth/profile" } }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        { "name": "List transactions", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/transactions" } },
        { "name": "Create weekly groceries", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Weekly groceries\",\n  \"amount\": 84.50,\n  \"type\": \"expense\",\n  \"category\": \"Food\",\n  \"date\": \"2025-05-27\"\n}" }, "url": "{{baseUrl}}/transactions" } },
        { "name": "Monthly summary", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/transactions/monthly-summary?month=2025-05" } },
        { "name": "Update transaction", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Weekly groceries and household items\",\n  \"amount\": 92.00\n}" }, "url": "{{baseUrl}}/transactions/{{transactionId}}" } },
        { "name": "Delete transaction", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/transactions/{{transactionId}}" } }
      ]
    },
    { "name": "Categories", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/categories" } },
    { "name": "Admin overview", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/overview" } }
  ]
}